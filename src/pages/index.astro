---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const models = await getCollection('models');
const labs = await getCollection('labs');
const researchers = await getCollection('researchers');

// Sort models by release date descending
const latestModels = models
  .sort((a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf())
  .slice(0, 4); // Get 4 for bento layout

const featuredModel = latestModels[0];
const otherModels = latestModels.slice(1, 4);
---

<Layout title="AI Info Catalog | 最新のAIモデルと研究情報を網羅">
  <!-- Hero Section -->
  <div class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-black tracking-tight text-slate-900 mb-6">
          The Hub for AI <span class="text-blue-600">Innovation</span>
        </h1>
        <p class="text-xl text-slate-500 mb-10 leading-relaxed">
          最新のAIモデル、革新的な研究を行うラボ、そして業界を牽引するトップ研究者の動向を、日本人向けに整理して提供するテクノロジーポータル。
        </p>
        <div class="flex justify-center gap-4">
          <a href="/models" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg shadow-sm transition-colors text-lg">
            モデル一覧を見る
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Featured Section (Bento Grid) -->
    <div class="mb-20">
      <div class="flex justify-between items-baseline mb-8 border-b border-slate-200 pb-4">
        <h2 class="text-3xl font-black tracking-tight text-slate-900">Latest Models</h2>
        <a href="/models" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors">View All &rarr;</a>
      </div>

      {featuredModel && (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          <!-- Main Featured Card -->
          <a href={`/models/${featuredModel.id}`} class="lg:col-span-8 group relative flex flex-col rounded-2xl overflow-hidden bg-slate-100 shadow-sm hover:shadow-md transition-shadow">
            <div class="aspect-w-16 aspect-h-9 sm:aspect-h-7 lg:aspect-h-8 w-full overflow-hidden">
              <img src={featuredModel.data.image || "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?q=80&w=1200&auto=format&fit=crop"} alt={featuredModel.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 p-8">
              <div class="flex gap-2 mb-3">
                <span class="px-3 py-1 bg-blue-600 text-white text-xs font-bold uppercase tracking-wider rounded-md">{featuredModel.data.lab}</span>
                <span class="px-3 py-1 bg-white/20 backdrop-blur-md text-white text-xs font-bold rounded-md">{featuredModel.data.releaseDate.toISOString().split('T')[0]}</span>
              </div>
              <h3 class="text-3xl md:text-4xl font-black text-white mb-2 group-hover:text-blue-200 transition-colors">{featuredModel.data.title}</h3>
              <p class="text-slate-200 line-clamp-2 max-w-2xl">{featuredModel.data.description}</p>
            </div>
          </a>

          <!-- Secondary Grid -->
          <div class="lg:col-span-4 flex flex-col gap-8">
            {otherModels.map(model => (
              <a href={`/models/${model.id}`} class="group flex flex-row lg:flex-col gap-4 lg:gap-0 lg:h-full bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-slate-100">
                <div class="w-1/3 lg:w-full lg:h-40 shrink-0 overflow-hidden">
                  <img src={model.data.image || "https://images.unsplash.com/photo-1620712943543-bcc4688e7485?q=80&w=800&auto=format&fit=crop"} alt={model.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <div class="flex flex-col justify-center lg:p-5 flex-1 pr-4 py-4 lg:pr-5 lg:py-0">
                  <div class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">{model.data.lab}</div>
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1 mb-1">{model.data.title}</h3>
                  <p class="text-sm text-slate-500 line-clamp-2">{model.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Labs Section -->
    <div class="mb-20">
      <div class="flex justify-between items-baseline mb-8 border-b border-slate-200 pb-4">
        <h2 class="text-3xl font-black tracking-tight text-slate-900">Top Laboratories</h2>
        <a href="/labs" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors">View All &rarr;</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {labs.slice(0, 3).map(lab => (
          <a href={`/labs/${lab.id}`} class="group block">
            <div class="rounded-xl overflow-hidden aspect-video mb-4 shadow-sm">
              <img src={lab.data.image || "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800&auto=format&fit=crop"} alt={lab.data.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{lab.data.name}</h3>
            <p class="text-sm text-slate-500 mb-2">{lab.data.location}</p>
            <p class="text-slate-600 line-clamp-2">{lab.data.description}</p>
          </a>
        ))}
      </div>
    </div>

    <!-- Researchers Section -->
    <div>
      <div class="flex justify-between items-baseline mb-8 border-b border-slate-200 pb-4">
        <h2 class="text-3xl font-black tracking-tight text-slate-900">Key Researchers</h2>
        <a href="/researchers" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors">View All &rarr;</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6">
        {researchers.slice(0, 4).map(researcher => (
          <a href={`/researchers/${researcher.id}`} class="group flex flex-col items-center text-center p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
            <div class="w-24 h-24 rounded-full overflow-hidden mb-4 shadow-inner ring-4 ring-slate-50 group-hover:ring-blue-50 transition-all">
              {researcher.data.image ? (
                <img src={researcher.data.image} alt={researcher.data.name} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-slate-200 flex items-center justify-center text-3xl font-bold text-slate-400">
                  {researcher.data.name.charAt(0)}
                </div>
              )}
            </div>
            <h3 class="font-bold text-lg text-slate-900 group-hover:text-blue-600 transition-colors">{researcher.data.name}</h3>
            <p class="text-sm font-medium text-blue-600 mb-1">{researcher.data.lab}</p>
            <p class="text-xs text-slate-500">{researcher.data.role}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
