---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const labs = await getCollection('labs');
---

<Layout title="AIラボ一覧 | AI Info Catalog">
  <div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">主要AIラボ</h1>
    <p class="text-gray-600 dark:text-gray-300">世界をリードするAI研究機関や企業の一覧です。</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {labs.map(lab => (
      <a href={`/labs/${lab.id}`} class="flex flex-col p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 dark:border-gray-700">
        <h2 class="text-2xl font-semibold mb-2">{lab.data.name}</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">{lab.data.location}</p>
        <p class="text-gray-700 dark:text-gray-300 line-clamp-3 mb-4">{lab.data.description}</p>
      </a>
    ))}
  </div>
</Layout>
