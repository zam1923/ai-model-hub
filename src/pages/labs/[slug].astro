---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map(lab => ({
    params: { slug: lab.id },
    props: { lab },
  }));
}

const { lab } = Astro.props;
const { Content } = await render(lab);

// Get models associated with this lab
const allModels = await getCollection('models');
const labModels = allModels.filter(model => model.data.lab === lab.data.name)
  .sort((a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf());

// Get researchers associated with this lab
const allResearchers = await getCollection('researchers');
const labResearchers = allResearchers.filter(researcher => researcher.data.lab === lab.data.name);
---

<Layout title={`${lab.data.name} | AI Info Catalog`}>
  <!-- Hero Section -->
  <div class="relative bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-40">
      <img src={lab.data.image || "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=2000&auto=format&fit=crop"} alt="Background" class="w-full h-full object-cover blur-sm" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-slate-900/40"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24 lg:pt-20 lg:pb-32">
      <a href="/labs" class="inline-flex items-center text-sm font-bold tracking-wider uppercase text-blue-400 hover:text-blue-300 transition-colors mb-8">
        &larr; Back to Labs
      </a>

      <div class="flex items-center gap-2 mb-6 text-slate-300 text-sm font-bold uppercase tracking-wider">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        {lab.data.location}
      </div>

      <h1 class="text-5xl md:text-7xl font-black tracking-tight mb-6">{lab.data.name}</h1>

      {lab.data.website && (
        <a href={lab.data.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-white text-slate-900 hover:bg-slate-100 font-bold rounded-xl transition-colors mt-4">
          Visit Official Site
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      )}
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">

      <!-- Main Info & Researchers -->
      <div class="lg:col-span-2 space-y-16">
        <section class="bg-white rounded-2xl p-8 md:p-12 shadow-sm border border-slate-100">
          <h2 class="text-2xl font-black uppercase tracking-wider text-slate-900 mb-8 border-b border-slate-200 pb-4">About the Lab</h2>
          <div class="mb-8 pb-4 border-b border-slate-100">
            <p class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-1">By AI Info Editorial Desk</p>
          </div>
          <article class="prose prose-lg prose-slate prose-headings:font-black prose-a:text-blue-600 hover:prose-a:text-blue-500 max-w-none first-letter:text-6xl first-letter:font-black first-letter:text-slate-900 first-letter:mr-3 first-letter:float-left mb-12">
            <Content />
          </article>

          {lab.data.sourceUrl && (
            <div class="mt-8 p-6 bg-slate-50 border border-slate-200 rounded-2xl">
              <h3 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-3">Original Source / 引用元</h3>
              <a href={lab.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between p-3 bg-white border border-slate-200 rounded-xl hover:border-blue-500 transition-all">
                <div class="flex-1 pr-4">
                  <p class="text-sm font-bold text-slate-900 group-hover:text-blue-600 transition-colors line-clamp-1">{lab.data.sourceTitle || "関連記事を読む"}</p>
                </div>
                <div class="text-blue-600">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                </div>
              </a>
            </div>
          )}
        </section>

        {labResearchers.length > 0 && (
          <section>
            <h2 class="text-2xl font-black uppercase tracking-wider text-slate-900 mb-8 border-b border-slate-200 pb-4">Key Personnel</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {labResearchers.map(researcher => (
                <a href={`/researchers/${researcher.id}`} class="group flex items-center p-4 bg-white rounded-xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
                  <div class="w-16 h-16 rounded-full overflow-hidden mr-4 shrink-0 shadow-inner">
                    {researcher.data.image ? (
                      <img src={researcher.data.image} alt={researcher.data.name} class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full bg-slate-200 flex items-center justify-center text-xl font-black text-slate-400">
                        {researcher.data.name.charAt(0)}
                      </div>
                    )}
                  </div>
                  <div>
                    <h3 class="font-bold text-slate-900 group-hover:text-blue-600 transition-colors">{researcher.data.name}</h3>
                    <p class="text-sm text-slate-500">{researcher.data.role}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Models Sidebar -->
      <div class="lg:col-span-1">
        {labModels.length > 0 && (
          <div class="bg-slate-50 rounded-2xl p-8 border border-slate-100 sticky top-24">
            <h2 class="text-lg font-black uppercase tracking-wider text-slate-900 mb-6 border-b border-slate-200 pb-4">Developed Models</h2>
            <div class="flex flex-col gap-6">
              {labModels.map(model => (
                <a href={`/models/${model.id}`} class="group flex flex-col bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition-all border border-slate-100">
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-1">{model.data.title}</h3>
                  <div class="flex items-center gap-2 mb-2 text-xs font-medium text-slate-500">
                    <span>{model.data.releaseDate.toISOString().split('T')[0]}</span>
                    <span>&bull;</span>
                    <span class="uppercase">{model.data.license}</span>
                  </div>
                  <p class="text-sm text-slate-600 line-clamp-2">{model.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

    </div>
  </div>
</Layout>
