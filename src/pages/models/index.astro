---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const models = await getCollection('models');
const sortedModels = models.sort((a, b) => b.data.releaseDate.valueOf() - a.data.releaseDate.valueOf());
---

<Layout title="モデル一覧 | AI Info Catalog">
  <div class="mb-8">
    <h1 class="text-3xl md:text-4xl font-bold mb-4">AIモデル一覧</h1>
    <p class="text-gray-600 dark:text-gray-300">最新の大規模言語モデルやマルチモーダルモデルの情報を網羅しています。</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sortedModels.map(model => (
      <a href={`/models/${model.id}`} class="block p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow border border-gray-100 dark:border-gray-700">
        <h2 class="text-2xl font-semibold mb-3">{model.data.title}</h2>

        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-xs font-medium rounded">{model.data.lab}</span>
          <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-xs font-medium rounded">{model.data.releaseDate.toISOString().split('T')[0]}</span>
          <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-medium rounded">{model.data.license}</span>
        </div>

        <p class="text-gray-700 dark:text-gray-300 text-sm line-clamp-3 mb-4">{model.data.description}</p>

        {model.data.modalities && (
          <div class="flex flex-wrap gap-1">
            {model.data.modalities.map(mod => (
              <span class="px-2 py-0.5 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 text-[10px] uppercase font-bold rounded-full">{mod}</span>
            ))}
          </div>
        )}
      </a>
    ))}
  </div>
</Layout>
